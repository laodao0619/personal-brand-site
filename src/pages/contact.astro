---
import Site from '../layouts/Site.astro';

const channels = ['邮箱', '小红书', 'Instagram'];
const pendingLabel = '\u5F85\u586B\u5199';
---
<Site title="联系我">
  <section class="sec">
    <div class="sec-head"><h1>联系我</h1></div>
    <ul class="contact-list">
      {channels.map(channel => (
        <li>
          <span>{channel}</span>
          <span>{pendingLabel}</span>
        </li>
      ))}
    </ul>
  </section>
</Site>
