---
import SeaCreature from '../components/SeaCreature.astro';
import { MAX_DEPTH, zones, encounters, sources } from '../content/deep-sea';
const stops = [
  ...zones.map(zone => ({ depth: zone.depth, zone, encounter: null })),
  ...encounters.map(encounter => ({ depth: encounter.depth, zone: null, encounter })),
].sort((a,b) => a.depth - b.depth);
const format = (n: number) => n.toLocaleString('zh-CN', { maximumFractionDigits: 2 });
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
    <meta name="description" content="从窗边出发，滚动下潜约一万一千米。遇见深海生命，读懂海洋的尺度。"/>
    <meta name="color-scheme" content="dark"/><link rel="icon" href="/seal.svg" type="image/svg+xml"/>
    <title>深海下潜 · 高嘉隆</title>
  </head>
  <body>
    <a class="skip" href="#ocean">跳到下潜区域</a>
    <header class="surface" id="surface">
      <nav class="masthead" aria-label="页面导航"><a href="/">← 窗边信号站</a><span>FIELD NOTES / 010</span><a href="#sources">资料与说明 ↗</a></nav>
      <div class="intro">
        <p class="eyebrow">窗外，还有另一片宇宙。</p>
        <h1>向海的<br/>深处<span>。</span></h1>
        <div class="intro-bottom"><p>让光慢慢退后。<br/>从海面出发，去见一万米以下的世界。</p><a class="begin" href="#ocean">开始下潜 <span>↓</span></a></div>
      </div>
      <div class="surface-line"><span>海平面 · 0 M</span><span>SCROLL TO DESCEND</span></div>
      <div class="surface-art" aria-hidden="true"><i></i><i></i><i></i><span>≈</span></div>
    </header>

    <aside class="instrument" aria-label="实时深度" hidden>
      <div class="instrument-top"><span class="signal-dot"></span><span data-zone>阳光层</span><span data-percent>0%</span></div>
      <p><strong data-meters>0</strong> <span>米</span></p><small><span data-feet>0</span> ft · 模拟深度</small>
      <progress aria-label="下潜进度" max={MAX_DEPTH} value="0"></progress>
      <p class="hint" data-hint>海面 · 准备出发</p>
      <details><summary>跳转深度</summary><nav aria-label="海洋分层">{zones.map(z=><a href={`#depth-${z.depth}`}>{z.name} · {format(z.depth)} m</a>)}<a href="#bottom">挑战者深渊 ↓</a><a href="#surface">返回海面 ↑</a></nav></details>
    </aside>

    <main id="ocean">
      <p class="reading-note">一条跨海域的深度之旅。生物位置依据观测或栖息范围选择，并非都生活在马里亚纳海沟；剪影不按体长比例。浅层滚动尺度放大，深度以标注为准。</p>
      <noscript><p class="reading-note">当前为静态阅读模式：每个节点均标有深度。开启 JavaScript 后可查看实时深度计。</p></noscript>
      <div class="water-column">
        {stops.map((stop, index) => {
          const nextDepth = stops[index+1]?.depth ?? MAX_DEPTH;
          const gap = Math.max(stop.zone ? 200 : 480, (nextDepth-stop.depth)*1.7);
          const zoneIndex = zones.findLastIndex(z=>stop.depth>=z.depth);
          return <section class:list={['stop', `water-${zoneIndex}`, { 'zone-stop': !!stop.zone, 'on-right': index % 2 === 0 }]} style={`--space:${gap}px`} data-depth={stop.depth} id={`depth-${stop.depth}`}>
            {stop.zone ? <div class="zone-heading"><p>{stop.zone.english} / {stop.zone.range}</p><h2>{stop.zone.name}</h2><p>{stop.zone.text}</p></div> : stop.encounter && <article class:list={['encounter', { landmark: stop.encounter.kind === 'landmark' }]} style={`--creature:${stop.encounter.color ?? '#b9d6df'}`}>
              <p class="depth-label">↓ {format(stop.depth)} <span>米</span></p>
              <div class="silhouette"><SeaCreature shape={stop.encounter.shape}/></div>
              <p class="latin">{stop.encounter.latin ?? 'HUMAN FOOTPRINT / 人类的刻度'}</p>
              <h2>{stop.encounter.name}</h2><p class="description">{stop.encounter.text}</p>
              <details class="evidence"><summary>深度依据 ↗</summary><p>{stop.encounter.evidence}</p><a href={stop.encounter.url} target="_blank" rel="noopener noreferrer">查看原始资料（新窗口） ↗</a></details>
            </article>}
          </section>;
        })}
        <section class="bottom" id="bottom" data-depth={MAX_DEPTH}>
          <p class="eyebrow">CHALLENGER DEEP / 马里亚纳海沟</p>
          <h2>10,935<span> 米</span></h2><p class="bottom-title">已抵达，挑战者深渊。</p>
          <p>约一万一千米的水，在我们头顶。<br/>这段旅程的终点，是理解海洋的起点。</p>
          <div class="trieste"><span aria-hidden="true">◉</span><div><h3>1960 · Trieste</h3><p>1 月 23 日，Jacques Piccard 与 Don Walsh 乘坐 Trieste 号，首次载人抵达挑战者深渊。</p><a href={sources[2].url} target="_blank" rel="noopener noreferrer">阅读这次下潜 ↗</a></div></div>
          <p class="measurement">终点采用 NOAA 约 10,935 米的测量口径。不同测次、地点及方法会有差异，并非每次下潜都达到同一数字。</p>
          <a class="return" href="#surface">已到底部，返回海面 ↑</a>
        </section>
      </div>
      <section class="sources" id="sources"><p class="eyebrow">航行之后 / READING ROOM</p><h2>给好奇心，一个出处。</h2><p>每个生物与地标下方均有「深度依据」。展示位置不是物种唯一的生活深度，也不代表其最大下潜能力。空旷段落是叙事留白，不意味着那里没有生命。</p><ul>{sources.map(s=><li><a href={s.url} target="_blank" rel="noopener noreferrer">{s.title} ↗</a></li>)}</ul><p>资料核对：2026-11-26。图形为本站原创示意；功能灵感来自 <a href="https://neal.fun/deep-sea/" target="_blank" rel="noopener noreferrer">Neal.fun The Deep Sea</a>，未使用其图片与文案。</p><a class="home-link" href="/">← 回到窗边信号站</a></section>
    </main>
    <footer>高嘉隆 · 窗边信号站 <span>把好奇心，留给更远的地方。</span></footer>
  </body>
</html>

<script>
  import { zones, MAX_DEPTH } from '../content/deep-sea';
  const panel = document.querySelector<HTMLElement>('.instrument')!;
  const markers = [...document.querySelectorAll<HTMLElement>('[data-depth]')];
  const meter = document.querySelector<HTMLElement>('[data-meters]')!;
  const feet = document.querySelector<HTMLElement>('[data-feet]')!;
  const zone = document.querySelector<HTMLElement>('[data-zone]')!;
  const percent = document.querySelector<HTMLElement>('[data-percent]')!;
  const progress = document.querySelector<HTMLProgressElement>('progress')!;
  const hint = document.querySelector<HTMLElement>('[data-hint]')!;
  let positions: { y: number; depth: number; label: string }[] = [];
  let queued = false;
  function measure() {
    positions = markers.map(el=>({ y: el.getBoundingClientRect().top + window.scrollY, depth: Number(el.dataset.depth), label: el.querySelector('h2')?.textContent ?? '' }));
    schedule();
  }
  function update() {
    queued = false;
    const y = window.scrollY + window.innerHeight * .3;
    // Anchor scrolling rounds to device pixels; tolerate one CSS pixel at a stop.
    let i = positions.findLastIndex(p=>p.y<=y+1);
    const current = positions[Math.max(0,i)];
    const next = positions[Math.max(0,i)+1];
    const depth = i<0 ? 0 : !next ? MAX_DEPTH : current.depth + (next.depth-current.depth)*Math.min(1,Math.max(0,(y-current.y)/(next.y-current.y)));
    const rounded = Math.round(depth);
    meter.textContent = rounded.toLocaleString('zh-CN');
    feet.textContent = Math.round(depth / .3048).toLocaleString('zh-CN');
    zone.textContent = zones.findLast(z=>rounded>=z.depth)?.name ?? zones[0].name;
    percent.textContent = `${Math.round(depth/MAX_DEPTH*100)}%`;
    progress.value = depth;
    hint.textContent = i<0 ? '海面 · 准备出发' : !next ? '已到底部 · 挑战者深渊' : `已抵达 · ${current.label}`;
  }
  function schedule() { if (!queued) { queued = true; requestAnimationFrame(update); } }
  panel.hidden = false;
  window.addEventListener('scroll', schedule, { passive: true });
  window.addEventListener('resize', measure);
  window.addEventListener('pageshow', measure);
  new ResizeObserver(measure).observe(document.querySelector('.water-column')!);
  panel.querySelectorAll('a').forEach(a=>a.addEventListener('click',()=>panel.querySelector('details')!.open=false));
  measure();
</script>

<style>
  :global(*){box-sizing:border-box} :global(html){scroll-behavior:smooth;background:#030912} :global(body){margin:0;color:#e5eef1;font:16px/1.7 'PingFang SC','Microsoft YaHei',system-ui,sans-serif;overflow-wrap:anywhere} :global(a){color:inherit;text-underline-offset:5px} :global(a:focus-visible),:global(summary:focus-visible){outline:3px solid #d8c5ff;outline-offset:6px} :global(h1),:global(h2),:global(h3),:global(p){margin:0} :global([hidden]){display:none!important}
  .skip{position:absolute;top:-80px;left:12px;z-index:100;background:#fff;color:#111;padding:12px}.skip:focus{top:12px}
  .surface{position:relative;min-height:90svh;background:#dce8e3;color:#213c43;overflow:hidden}.masthead{position:relative;z-index:1;display:flex;justify-content:space-between;align-items:center;gap:16px;margin:0 5vw;padding:24px 0;border-bottom:1px solid #213c4350;font-size:13px}.masthead a{text-decoration:none}.masthead span{font:11px monospace;letter-spacing:.12em}
  .intro{position:relative;z-index:1;max-width:1080px;padding:65px 6vw 70px}.eyebrow{font-size:12px;letter-spacing:.18em}.intro h1{font-size:clamp(78px,12vw,160px);line-height:1.03;letter-spacing:-.065em;margin:22px 0 38px;font-weight:900}.intro h1 span{color:#76649e}.intro-bottom{display:flex;align-items:end;gap:50px;flex-wrap:wrap}.intro-bottom p{font-size:15px}.begin,.return{display:inline-flex;gap:40px;padding:14px 23px;border:1px solid currentColor;text-decoration:none;background:#ddd1ff;color:#292044;box-shadow:4px 4px 0 #213c43}.begin:hover,.return:hover{background:#eee6ff}.surface-line{display:flex;justify-content:space-between;gap:16px;position:relative;z-index:1;border-top:1px solid #213c4360;padding:20px 6vw;font:11px monospace;letter-spacing:.12em}.surface-art{position:absolute;right:-7%;top:20%;width:52vw;height:480px;opacity:.35;transform:rotate(-18deg)}.surface-art i{position:absolute;inset:12%;border:1px solid #436f79;border-radius:50%}.surface-art i:nth-child(2){inset:2%}.surface-art i:nth-child(3){inset:22%}.surface-art span{position:absolute;inset:15%;font-size:250px;line-height:1;color:#6c8799}
  .instrument{position:fixed;right:24px;bottom:24px;z-index:30;width:218px;background:#101b2bf2;border:1px solid #668096;padding:15px 18px;box-shadow:4px 4px 0 #0005;font-size:12px;color:#e6f0f3}.instrument-top{display:flex;align-items:center;gap:8px;color:#b6cdd6}.instrument-top [data-percent]{margin-left:auto}.signal-dot{width:6px;height:6px;border-radius:50%;background:#bce0ca}.instrument strong{font:500 36px/1.4 ui-monospace,monospace;letter-spacing:-.06em}.instrument small{color:#bdd0d9}.instrument progress{display:block;appearance:none;width:100%;height:3px;margin:12px 0;background:#314554;border:0}.instrument progress::-webkit-progress-bar{background:#314554}.instrument progress::-webkit-progress-value{background:#cbb8fa}.instrument progress::-moz-progress-bar{background:#cbb8fa}.hint{font-size:10px;min-height:30px;line-height:1.5;color:#c4c0da}.instrument summary{cursor:pointer;padding:4px 0}.instrument nav{display:grid;gap:8px;padding-top:12px;max-height:45svh;overflow:auto}.instrument nav a{padding:4px 0}.instrument details[open]{border-top:1px solid #425366}
  main{background:#071421}.reading-note{background:#204b5d;padding:28px max(7vw,24px);font-size:12px;color:#d6e7ed;max-width:none;padding-right:max(26vw,24px)}.water-column{position:relative;background:linear-gradient(#204b5d,#112d46 25%,#070f20 47%,#030912 70%,#02050b);}.water-column::before{content:'';position:absolute;left:6vw;top:0;bottom:0;width:18px;border-left:1px solid #b1c9db30;background:repeating-linear-gradient(to bottom,transparent 0 99px,#b1c9db45 99px 100px);pointer-events:none}
  .stop{min-height:var(--space);position:relative;padding:0 max(10vw,32px) 70px;scroll-margin-top:30vh}.encounter{position:relative;width:min(380px,100%);margin-left:12%;padding-top:25px}.on-right .encounter{margin-left:46%}.depth-label{font:13px ui-monospace,monospace;letter-spacing:.1em;color:#a9c9da;border-top:1px solid #b1c9db40;padding-top:12px}.depth-label span{font-size:10px}.silhouette{width:100%;max-width:320px;height:180px;color:var(--creature);animation:drift 8s ease-in-out infinite}.silhouette svg{width:100%;height:100%}.latin{font:italic 11px Georgia,serif;color:#a7b6c7;margin:8px 0}.encounter h2{font-size:clamp(25px,3vw,37px);letter-spacing:.02em;font-weight:600}.description{font-size:14px;max-width:27em;margin:12px 0 14px;color:#c4d1dd}.evidence{font-size:11px;color:#b0c4d1}.evidence summary{cursor:pointer;min-height:30px}.evidence p{margin:8px 0}.evidence a{display:inline-block;padding-block:8px}.landmark .silhouette{opacity:.85}.landmark h2{color:#ddc9f5}.zone-heading{border-top:1px solid #b9cbd44d;padding:24px 0 32px;margin-left:0}.zone-heading h2{font-size:clamp(32px,5vw,60px);font-weight:400;letter-spacing:.12em;margin:8px 0}.zone-heading p:first-child{font:11px ui-monospace,monospace;letter-spacing:.15em;color:#b3cbd8}.zone-heading p:last-child{font-size:13px;color:#a9bdca}.water-2,.water-3,.water-4{background:#02061155}.water-3{min-height:max(var(--space),1500px)}
  .bottom{position:relative;padding:100px max(10vw,32px) 150px;scroll-margin-top:30vh;background:linear-gradient(transparent,#0e1223);border-top:1px solid #62778b50}.bottom h2{font:400 clamp(54px,10vw,130px)/1.4 ui-monospace,monospace;letter-spacing:-.075em;margin:25px 0 0}.bottom h2 span{font-size:20px;letter-spacing:0}.bottom-title{font-size:clamp(23px,3vw,36px);margin-bottom:25px;color:#ddd1ff}.bottom>p:not(.eyebrow):not(.bottom-title){font-size:14px;color:#b9c4d5;max-width:620px}.trieste{display:flex;gap:25px;max-width:590px;border-block:1px solid #71839850;margin:60px 0 30px;padding:24px 0}.trieste>span{font-size:48px;color:#c7c9dc}.trieste h3{font:20px ui-monospace,monospace;margin-bottom:12px}.trieste p,.trieste a{font-size:13px;color:#c2ccda}.trieste a{display:inline-block;margin-top:12px}.measurement{margin-bottom:32px}.sources{padding:65px max(10vw,32px);padding-right:max(25vw,32px);background:#e8e2f0;color:#302943}.sources h2{font-size:clamp(26px,4vw,44px);margin:18px 0 25px}.sources p,.sources li{font-size:13px;max-width:700px}.sources ul{padding-left:20px;line-height:2.3}.home-link{display:inline-block;margin-top:30px;font-size:14px}footer{padding:30px 6vw 270px;font-size:12px;display:flex;gap:15px;justify-content:space-between;color:#a9b7c9}
  @keyframes drift{0%,100%{transform:translateY(0) rotate(-1deg)}50%{transform:translateY(-8px) rotate(1deg)}}
  @media(min-width:701px) and (max-width:1099px){.encounter{margin-left:0}.on-right .encounter{margin-left:auto}}
  @media(min-width:1100px){.stop{padding-right:25vw}.on-right .encounter{margin-left:45%}.encounter{max-width:340px}.bottom{padding-right:300px}}
  @media(max-width:700px){.masthead{font-size:11px;gap:10px}.masthead span{display:none}.intro{padding:55px 7vw 60px}.surface-art{width:90vw;right:-40%;top:27%;opacity:.23}.intro-bottom{gap:25px}.intro h1{font-size:88px}.surface{min-height:0}.surface-line{font-size:9px}.reading-note{padding:24px 8vw}.instrument{right:12px;bottom:12px;width:166px;padding:10px 12px}.instrument strong{font-size:28px}.instrument-top{font-size:10px}.instrument small{font-size:9px}.instrument progress{margin:8px 0}.hint{font-size:9px;min-height:0}.instrument summary{font-size:10px}.water-column::before{left:20px;width:8px}.stop{padding:0 25px 90px 48px}.encounter,.on-right .encounter{margin-left:0;width:100%;max-width:370px}.encounter h2{font-size:27px}.description{font-size:13px}.silhouette{max-width:260px;height:160px}.zone-heading h2{font-size:36px}.zone-heading p:last-child{max-width:220px}.bottom{padding:75px 30px 240px}.bottom h2{font-size:56px}.trieste{gap:15px}.sources{padding:50px 30px 220px}footer{flex-direction:column;padding-bottom:230px}}
  @media(prefers-reduced-motion:reduce){:global(html){scroll-behavior:auto}.silhouette{animation:none}}
</style>
