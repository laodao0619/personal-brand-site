---
import Site from '../layouts/Site.astro';

const trails = Array.from({ length: 27 }, (_, index) => ({
  x: 3 + (index * 29 % 95),
  offset: -((index * 71 % 180) / 100),
  speed: 1.1 + (index * 17 % 100) / 100,
  start: index * 43 % 420,
  length: 14 + (index * 19 % 51),
  opacity: 0.16 + (index % 5) * 0.12,
}));
---
<Site title="雨声">
  <section class="rain-page" data-player data-playing="false">
    <div class="rain-controls">
      <h1>雨声室</h1>
      <p class="rain-intro">学习、阅读或休息时，让雨声留在背景里。</p>
      <div class="play-row">
        <button class="play-button" type="button" data-play>
          <span class="play-icon" aria-hidden="true"></span>
          <span data-play-label>播放雨声</span>
        </button>
        <p class="play-status" role="status" data-status>待播放</p>
      </div>

      <fieldset class="mix-options">
        <legend>声音模式</legend>
        <div>
          <label><input type="radio" name="mix" value="rain" checked />纯雨声</label>
          <label><input type="radio" name="mix" value="music" />雨声 + 环境音乐</label>
        </div>
      </fieldset>

      <div class="volume-control">
        <label for="rain-volume">音量</label>
        <output for="rain-volume" data-level>65%</output>
        <input id="rain-volume" type="range" min="0" max="100" value="65" />
      </div>
      <noscript>开启 JavaScript 后即可播放雨声。</noscript>
    </div>

    <div class="rain-art" aria-hidden="true">
      <div class="rain-light"></div>
      <div class="rain-trails">
        {trails.map(({ x, offset, speed, start, length, opacity }) => (
          <i style={`--x:${x}%;--delay:${offset}s;--speed:${speed}s;--start:${start}px;--length:${length}px;--opacity:${opacity}`}></i>
        ))}
      </div>
      <div class="ripples">
        <i></i><i></i><i></i><i></i>
      </div>
    </div>
  </section>
</Site>

<script>
  import { createRainPlayer } from '../scripts/rain-audio';

  const page = document.querySelector<HTMLElement>('[data-player]')!;
  const button = page.querySelector<HTMLButtonElement>('[data-play]')!;
  const label = page.querySelector<HTMLElement>('[data-play-label]')!;
  const status = page.querySelector<HTMLElement>('[data-status]')!;
  const slider = page.querySelector<HTMLInputElement>('#rain-volume')!;
  const level = page.querySelector<HTMLOutputElement>('[data-level]')!;
  const mix = page.querySelector<HTMLInputElement>('[value="music"]')!;
  let player: ReturnType<typeof createRainPlayer> | undefined;
  let suspendTimer: number | undefined;
  let starting = false;

  function setPlaying(playing: boolean, message: string) {
    page.dataset.playing = String(playing);
    label.textContent = playing ? '暂停雨声' : '播放雨声';
    status.textContent = message;
  }

  function applyVolume() {
    const volume = slider.valueAsNumber;
    level.value = `${volume}%`;
    if (page.dataset.playing === 'true') player?.setVolume(volume);
  }

  button.addEventListener('click', async () => {
    if (starting) return;
    window.clearTimeout(suspendTimer);
    if (player && page.dataset.playing === 'true') {
      setPlaying(false, '已暂停');
      player.setVolume(0);
      const context = player.context;
      suspendTimer = window.setTimeout(() => { void context.suspend().catch(() => {}); }, 150);
      return;
    }

    starting = true;
    button.setAttribute('aria-busy', 'true');
    try {
      if (!player) {
        player = createRainPlayer();
        const { context } = player;
        context.addEventListener('statechange', () => {
          if (context.state !== 'running' && page.dataset.playing === 'true') {
            setPlaying(false, '已暂停');
          }
        });
      }
      await player.context.resume();
      player.setMusic(mix.checked);
      setPlaying(true, '播放中');
      applyVolume();
    } catch {
      setPlaying(false, '播放失败，请重试');
    } finally {
      starting = false;
      button.removeAttribute('aria-busy');
    }
  });

  page.addEventListener('change', (event) => {
    if (event.target instanceof HTMLInputElement && event.target.name === 'mix' && page.dataset.playing === 'true') {
      player?.setMusic(mix.checked);
    }
  });
  slider.addEventListener('input', applyVolume);
  applyVolume();

  window.addEventListener('pagehide', () => {
    window.clearTimeout(suspendTimer);
    if (!player) return;
    setPlaying(false, '已暂停');
    player.setVolume(0);
    void player.context.suspend().catch(() => {});
  });
</script>

<style>
  .rain-page {
    display: grid;
    grid-template-columns: minmax(0, .94fr) minmax(0, 1.06fr);
    min-height: 550px;
    margin-top: clamp(24px, 5vw, 64px);
    border: 1px solid var(--line);
  }

  .rain-controls {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    min-width: 0;
    padding: clamp(24px, 4.4vw, 72px);
  }

  h1 {
    font-size: clamp(52px, 8vw, 118px);
    letter-spacing: -.045em;
    font-weight: 850;
    line-height: 1.1;
  }

  .rain-intro {
    max-width: 24em;
    margin-top: 14px;
    color: var(--secondary);
  }

  .play-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 16px;
    margin-block: 26px 30px;
  }

  .play-button {
    display: inline-flex;
    align-items: center;
    gap: 11px;
    min-height: 50px;
    padding: 11px 17px;
    background: var(--accent);
    color: var(--accent-ink);
    border: 1px solid var(--ink);
    font: 750 16px/1.3 var(--sans);
    cursor: pointer;
  }

  .play-button:hover { box-shadow: 3px 3px 0 var(--ink); }
  .play-button[aria-busy="true"] { cursor: wait; }
  .play-button:focus-visible, .volume-control input:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 4px;
  }

  .play-icon {
    width: 13px;
    height: 16px;
    background: currentColor;
    clip-path: polygon(0 0, 100% 50%, 0 100%);
  }

  [data-playing="true"] .play-icon {
    background: linear-gradient(90deg, currentColor 35%, transparent 35% 65%, currentColor 65%);
    clip-path: none;
  }

  .play-status { color: var(--muted); font-size: 13px; }
  .mix-options, .volume-control { width: min(100%, 380px); }
  .mix-options { margin: 0; padding: 0; border: 0; }
  .mix-options legend, .volume-control label { font-size: 14px; font-weight: 750; }
  .mix-options > div { display: flex; flex-wrap: wrap; gap: 6px 14px; margin-top: 4px; }

  .mix-options label {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    cursor: pointer;
    font-size: 14px;
  }

  .mix-options input, .volume-control input { accent-color: var(--focus); }
  .mix-options input { margin: 0; }

  .volume-control {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    margin-top: 15px;
  }

  .volume-control output { color: var(--muted); font-variant-numeric: tabular-nums; font-size: 14px; }
  .volume-control input { width: 100%; grid-column: 1 / -1; height: 34px; margin: 0; cursor: pointer; }

  .rain-art {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    min-height: 340px;
    background: radial-gradient(ellipse at 52% 82%, #445645 0, #263b33 35%, #162823 65%, #0e1918 100%);
  }

  .rain-light {
    position: absolute;
    inset: 13% 13% 17%;
    border: 1px solid #d4eb9860;
    border-radius: 48% 48% 46% 46%;
    background: radial-gradient(ellipse at 46% 12%, #bdce7a21, transparent 62%);
    transform: rotate(-12deg);
  }

  .rain-trails { position: absolute; inset: 0; opacity: .65; transform: skewX(-12deg); }
  .rain-trails i {
    position: absolute;
    left: var(--x);
    top: 0;
    width: 1px;
    height: var(--length);
    background: linear-gradient(transparent, #dff1ae);
    opacity: var(--opacity);
    transform: translateY(var(--start));
  }

  .ripples {
    position: absolute;
    inset: auto 8% 12%;
    height: 24%;
    display: grid;
    place-items: center;
    transform: rotate(-6deg);
  }

  .ripples i {
    grid-area: 1 / 1;
    width: 92%;
    height: 74%;
    border: 1px solid #dceba5;
    border-radius: 50%;
    opacity: .38;
    transform: scale(var(--ring));
  }
  .ripples i:nth-child(1) { --ring: .25; --ripple-delay: 0s; }
  .ripples i:nth-child(2) { --ring: .48; --ripple-delay: -.8s; }
  .ripples i:nth-child(3) { --ring: .72; --ripple-delay: -1.6s; }
  .ripples i:nth-child(4) { --ring: 1; --ripple-delay: -2.4s; }

  @media (max-width: 760px) {
    .rain-page { grid-template-columns: minmax(0, 1fr); }
    .rain-art { min-height: clamp(240px, 70vw, 380px); }
  }

  @media (prefers-reduced-motion: no-preference) {
    [data-playing="true"] .rain-trails i { animation: rainfall var(--speed) linear var(--delay) infinite; }
    [data-playing="true"] .ripples i { animation: ripple 3.2s ease-out var(--ripple-delay) infinite; }
    .play-button { transition: box-shadow .2s var(--ease); }

    @keyframes rainfall {
      from { transform: translateY(-70px); }
      to { transform: translateY(76vh); }
    }

    @keyframes ripple {
      from { transform: scale(.12); opacity: .62; }
      to { transform: scale(1.1); opacity: 0; }
    }
  }
</style>
